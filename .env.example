# Runtime
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

# Infrastructure
DATABASE_URL=postgresql+psycopg://meeting:meeting@postgres:5432/meeting_intelligence
REDIS_URL=redis://redis:6379/0
STORAGE_PROVIDER=local
STORAGE_PATH=/data
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
MAX_MEDIA_SIZE_BYTES=524288000
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
UPLOAD_CHUNK_SIZE=1048576
ASR_PROVIDER=faster-whisper
ASR_MODEL=base
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=
ASR_BEAM_SIZE=5
ASR_VAD_FILTER=true
ASR_TIMEOUT_SECONDS=1800
TRANSCRIPTION_QUEUE=meeting-intelligence:transcription
DIARIZATION_PROVIDER=pyannote
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_DEVICE=cpu
DIARIZATION_MIN_SPEAKERS=
DIARIZATION_MAX_SPEAKERS=
DIARIZATION_AUTH_TOKEN=
EVENT_EXTRACTION_PROVIDER=openai-compatible
EVENT_EXTRACTION_MODEL=
EVENT_EXTRACTION_TEMPERATURE=0
EVENT_EXTRACTION_TIMEOUT=120
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
MEETING_INTELLIGENCE_PROVIDER=openai-compatible
MEETING_INTELLIGENCE_MODEL=
MEETING_INTELLIGENCE_TEMPERATURE=0
MEETING_INTELLIGENCE_TIMEOUT=120

# Provider configuration (Phase 0 placeholders; integrations arrive in later phases)
ASR_PROVIDER=whisper
ASR_MODEL=base
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
DIARIZATION_PROVIDER=local
TRANSLATION_PROVIDER=local
TRANSLATION_MODEL=
LLM_PROVIDER=local
LLM_MODEL=
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
OCR_PROVIDER=local
VISION_PROVIDER=local
VISION_MODEL=
TARGET_LANGUAGE=en
